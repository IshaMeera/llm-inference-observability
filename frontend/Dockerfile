FROM node:22

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

RUN rm -rf .next

ARG NEXT_PUBLIC_CHAT_API
ARG NEXT_PUBLIC_ANALYTICS_API

ENV NEXT_PUBLIC_CHAT_API=$NEXT_PUBLIC_CHAT_API
ENV NEXT_PUBLIC_ANALYTICS_API=$NEXT_PUBLIC_ANALYTICS_API

ENV NODE_ENV=production

RUN npm run build

EXPOSE 3000

CMD ["npm","start"]